          false,
          null
        ],
        [
          "aaum_cr",
          "numeric(20,6)",
          false,
          null
        ],
        [
          "aaum_lakhs",
          "numeric(22,4)",
          false,
          null
        ]
      ],
      "constraints": [],
      "indexes": [],
      "definition": " SELECT s.scheme_code,\n    s.temp_sif_code,\n    s.scheme_name,\n    a.amc_name,\n    s.category,\n    s.category_sub,\n    s.scheme_plan,\n    s.scheme_option,\n    s.is_active,\n    n.nav_date,\n    n.nav,\n    q.aaum_quarter,\n    q.quarter_end AS aaum_quarter_end,\n    q.aaum_cr,\n    q.aaum_lakhs\n   FROM sif_schemes s\n     JOIN sif_amcs a ON a.amc_id = s.amc_id\n     LEFT JOIN LATERAL ( SELECT sif_nav_history.nav_date,\n            sif_nav_history.nav\n           FROM sif_nav_history\n          WHERE sif_nav_history.scheme_code = s.scheme_code\n          ORDER BY sif_nav_history.nav_date DESC\n         LIMIT 1) n ON true\n     LEFT JOIN LATERAL ( SELECT sif_aaum_history.aaum_quarter,\n            sif_aaum_history.quarter_end,\n            sif_aaum_history.aaum_cr,\n            sif_aaum_history.aaum_lakhs\n           FROM sif_aaum_history\n          WHERE sif_aaum_history.scheme_code = s.scheme_code\n          ORDER BY sif_aaum_history.quarter_end DESC\n         LIMIT 1) q ON true;"
    }
