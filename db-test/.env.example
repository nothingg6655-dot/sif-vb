# Copy to .env at the project root. Never commit real credentials.
PGHOST=localhost
PGPORT=5432
PGDATABASE=VB-SIF
PGEXPECTED_DATABASE=VB-SIF
PGUSER=postgres
PGPASSWORD=replace_with_local_password
PGSSLMODE=disable
# For Supabase use verify-full and the downloaded CA certificate path.
# PGSSLROOTCERT=data/certs/supabase-ca.crt
# Optional read-only credentials for the Node backend; Python uses PGUSER/PGPASSWORD.
# BACKEND_PGUSER=sif_backend.PROJECT_REF
# BACKEND_PGPASSWORD=replace_with_backend_role_password
PGCONNECT_TIMEOUT=10
PGPOOL_MAX=5
PGIDLE_TIMEOUT_MS=30000
PGSTATEMENT_TIMEOUT_MS=15000
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
LOG_LEVEL=info
TIGZIG_BASE_URL=https://sif.tigzig.com/
TIGZIG_DOWNLOAD_DIR=data/tigzig
TIGZIG_HTTP_TIMEOUT_SECONDS=30
TIGZIG_HTTP_RETRIES=3
TIGZIG_HTTP_BACKOFF_SECONDS=1
TIGZIG_SCHEDULE_INTERVAL_HOURS=2
TIGZIG_JOB_MAX_RETRIES=3
TIGZIG_JOB_BACKOFF_SECONDS=30
TIGZIG_JOB_MAX_BACKOFF_SECONDS=900
TIGZIG_JOB_JITTER_SECONDS=15
TIGZIG_JOB_MISFIRE_GRACE_SECONDS=3600
TIGZIG_RUN_STARTUP_RECOVERY=true
SYNC_FRESHNESS_MAX_MINUTES=1440
ADMIN_API_KEY=

# Run both scheduled workers inside this backend process (Render Docker image).
# Keep disabled on local API instances while Windows tasks are still registered.
INTERNAL_SCHEDULERS_ENABLED=false
SCHEDULER_SCOPE=render
SCHEDULER_PYTHON=python3
SCHEDULER_PGUSER=
SCHEDULER_PGPASSWORD=
FACTSHEET_MAX_WORKERS=1

